# Pulled result data: reproducible from the cluster, and `results/` is already
# ignored at the repo root for the same reason.
data/

# Generated by make_report.py. Tracking these would let the PDF's numbers and
# the data they came from drift apart silently, which is the whole thing this
# layout exists to prevent.
figures/
tables/
numbers.tex

# Local build environment (see `make venv`): system python3 on this
# machine has matplotlib but not pandas.
.venv/

# latexmk and friends
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
summary.pdf
